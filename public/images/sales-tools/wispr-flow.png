<script>
  (function () {
    var params = new URLSearchParams(location.search);
    ['utm_source', 'utm_medium', 'utm_campaign'].forEach(function (k) {
      var v = params.get(k);
      if (v) localStorage.setItem('wf_' + k, v);
    });
  })();
</script>

<!--Download button text - OS detection (site-wide). Promo variant lives in the home page's per-page head and owns the buttons when ?promo_code= is present.-->
<script>
  (function () {
    if (new URLSearchParams(window.location.search).get('promo_code')) return;

    const waitAndApply = () => {
      if (window.userPlatform) {
        const getOSText = (platform) => {
          switch (platform) {
            case 'mac_m1':
            case 'mac_intel':
            case 'mac_unknown':
              return 'Download for macOS';
            case 'Windows':
            case 'win_unknown':
              return 'Download for Windows';
            case 'iOS':
              return 'Download for iPhone';
            case 'Android':
              return 'Download for Android';
            default:
              return null;
          }
        };

        const platform = window.userPlatform;
        const osText = getOSText(platform);

        if (osText) {
          const buttons = document.querySelectorAll('[app-download]:not([no-change])');
          const appleIcon = document.querySelector('[apple-icon]');
          const windowsIcon = document.querySelector('[windows-icon]');
          const androidIcon = document.querySelector('[android-icon]');

          if (buttons.length === 0) {
            setTimeout(waitAndApply, 1);
            return;
          }

          buttons.forEach((button) => {
            button.textContent = osText;

            if ((platform === 'mac_m1' || platform === 'mac_intel' || platform === 'mac_unknown' || platform === 'iOS') && appleIcon) {
              button.prepend(appleIcon.cloneNode(true));
            } else if ((platform === 'Windows' || platform === 'win_unknown') && windowsIcon) {
              button.prepend(windowsIcon.cloneNode(true));
            } else if (platform === 'Android' && androidIcon) {
              button.prepend(androidIcon.cloneNode(true));
            }
          });

          const navContainer = document.querySelector('.nav_container-v2');
          if (navContainer) {
            if (platform === 'mac_m1' || platform === 'mac_intel' || platform === 'mac_unknown') {
              navContainer.classList.add('macos-button-fit');
            } else if (platform === 'Windows' || platform === 'win_unknown') {
              navContainer.classList.add('windows-button-fit');
            }
          }

          document.querySelector('.nav_big-button')?.classList.add('smaller');

          const setupAnims = () => {
            if (typeof setupButtonAnimations === 'function') {
              setupButtonAnimations('[app-download]');
            } else {
              setTimeout(setupAnims, 50);
            }
          };
          setupAnims();

          const reapply = () => {
            document.querySelectorAll('[app-download]:not([no-change])').forEach((btn) => {
              if (!btn.textContent.includes(osText)) {
                btn.textContent = osText;
                if ((platform === 'mac_m1' || platform === 'mac_intel' || platform === 'mac_unknown' || platform === 'iOS') && appleIcon) {
                  btn.prepend(appleIcon.cloneNode(true));
                } else if ((platform === 'Windows' || platform === 'win_unknown') && windowsIcon) {
                  btn.prepend(windowsIcon.cloneNode(true));
                } else if (platform === 'Android' && androidIcon) {
                  btn.prepend(androidIcon.cloneNode(true));
                }
              }
            });
          };
          setTimeout(reapply, 200);
          setTimeout(reapply, 600);
        }
      } else {
        setTimeout(waitAndApply, 1);
      }
    };
    waitAndApply();
  })();
</script>


