<!--Navbar dropdown click closes dropdown but not toggle bg color - fix -->
<script>
document.querySelectorAll('.nav_menu-dropdown-toggle-v2').forEach(wrapper => {
  const toggle = wrapper.querySelector('.dropdown1_toggle');
  if (!toggle) return;

  toggle.addEventListener('click', () => {
    if (window.innerWidth < 992) return;
    if (toggle.classList.contains('w--open')) {
      requestAnimationFrame(() => wrapper.classList.add('force-reset'));
    } else {
      wrapper.classList.remove('force-reset');
    }
  });

  wrapper.addEventListener('mouseleave', () => {
    wrapper.classList.remove('force-reset');
  });
});
</script>

<!--Remove rogue quotes-->
<script>
// Function to remove rogue quotes
function removeRogueQuotes() {
  const walker = document.createTreeWalker(
    document.body,
    NodeFilter.SHOW_TEXT,
    {
      acceptNode: (node) => {
        if (node.parentElement?.closest('.page-wrapper')) {
          return NodeFilter.FILTER_REJECT;
        }
        if (/^[""\s]+$/.test(node.textContent)) {
          return NodeFilter.FILTER_ACCEPT;
        }
        return NodeFilter.FILTER_REJECT;
      }
    }
  );

  const nodesToRemove = [];
  while (walker.nextNode()) {
    nodesToRemove.push(walker.currentNode);
  }

  nodesToRemove.forEach(node => node.remove());
}

// Run immediately
removeRogueQuotes();

// Run after DOM is fully loaded
document.addEventListener('DOMContentLoaded', removeRogueQuotes);

// Run after everything including external scripts
window.addEventListener('load', removeRogueQuotes);

// Watch for changes (in case plugin adds them dynamically)
const observer = new MutationObserver(() => {
  removeRogueQuotes();
});

observer.observe(document.body, {
  childList: true,
  subtree: true
});
</script>


<!--Navbar scroll animation-->
<script>
gsap.registerPlugin(ScrollTrigger);

const navbar = document.querySelector('.nav_fixed');

if (navbar && window.matchMedia('(max-width: 991px)').matches) {
  // Create the hide animation (from visible to hidden)
  const hideAnim = gsap.fromTo(navbar, 
    { yPercent: 0 }, 
    { yPercent: -100, duration: 0.5, ease: "power2.inOut", paused: true }
  );
  
  let lastScrollY = 0;
  let ticking = false;
  
  ScrollTrigger.create({
    start: "top top",
    end: "max",
    onUpdate: (self) => {
      const currentScrollY = self.scroll();
      if (!ticking) {
        requestAnimationFrame(() => {
          if (currentScrollY > lastScrollY && currentScrollY > 50) {
            // Scrolling down - hide navbar
            hideAnim.play();
          } else if (currentScrollY < lastScrollY) {
            // Scrolling up - show navbar
            hideAnim.reverse();
          }
          lastScrollY = currentScrollY;
          ticking = false;
        });
        ticking = true;
      }
    }
  });
}
</script>

<!-- Bottom Sticky Nav -->
<script>
if (window.matchMedia("(max-width: 991px)").matches) {
  window.addEventListener("load", () => {
    gsap.registerPlugin(ScrollTrigger);
    const bottomBar = document.querySelector(".nav_bottom");
    if (bottomBar && window.matchMedia("(max-width: 991px)").matches) {
      const showAnim = gsap.fromTo(
        bottomBar,
        { y: "100%" },
        {
          y: 0,
          duration: 0.5,
          ease: "power2.inOut",
          paused: true
        }
      );
      
      let lastScrollY = 0;
      let ticking = false;
      
      ScrollTrigger.create({
        start: "top top",
        end: "max",
        onUpdate: (self) => {
          const currentScrollY = self.scroll();
          if (!ticking) {
            requestAnimationFrame(() => {
              if (currentScrollY > lastScrollY && currentScrollY > 50) {
                showAnim.play();
              } else if (currentScrollY < lastScrollY) {
                showAnim.reverse();
              }
              lastScrollY = currentScrollY;
              ticking = false;
            });
            ticking = true;
          }
        }
      });
      
      // Hide bottom nav when footer is in view
      ScrollTrigger.create({
        trigger: ".section_footer",
        start: "top 80%",
        end: "bottom bottom",
        onEnter: () => {
          gsap.to(bottomBar, {
            opacity: 0,
            pointerEvents: "none",
            duration: 0.3
          });
        },
        onLeaveBack: () => {
          gsap.to(bottomBar, {
            opacity: 1,
            pointerEvents: "auto",
            duration: 0.3
          });
        }
      });
    }
  });
}
</script>

