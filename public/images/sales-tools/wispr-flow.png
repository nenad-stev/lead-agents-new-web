<!--No new tab opens in mobile (Arc browser issue)-->
<script>
if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
  document.querySelectorAll('a[target="_blank"]').forEach(link => {
    link.removeAttribute('target');
  });
}
